<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== Light Theme (Default) ========== -->
    <style name="Theme.MyApp"
        parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/sky_blue_primary</item>
        <item name="colorOnPrimary">@color/sky_on_primary_light</item>
        <item name="colorPrimaryContainer">@color/sky_blue_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/sky_blue_primary_dark</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/sky_blue_secondary</item>
        <item name="colorOnSecondary">@color/sky_on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/sky_blue_accent</item>
        <item name="colorOnSecondaryContainer">@color/sky_blue_primary_dark</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/sky_background_light</item>
        <item name="colorSurface">@color/sky_surface_light</item>
        <item name="colorSurfaceVariant">@color/sky_surface_variant_light</item>
        <item name="colorOnSurface">@color/sky_text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/sky_text_secondary_light</item>

        <!-- Outline -->
        <item name="colorOutline">@color/sky_outline_light</item>

        <!-- Error -->
        <item name="colorError">@color/sky_error_light</item>
        <item name="colorOnError">@color/sky_on_error_light</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/sky_blue_primary_dark</item>
        <item name="android:navigationBarColor">@color/sky_surface_light</item>

    </style>

    <!-- ========== Bottom Nav Styles (Telegram-like) ========== -->

    <!-- Hide the Material 3 pill/active indicator -->
    <style name="BottomNavIndicatorHidden" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Active tab label: small, bold -->
    <style name="BottomNavTextActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Inactive tab label: small, normal -->
    <style name="BottomNavTextInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>