<?xml version="1.0" encoding="utf-8"?>
<!-- Chats Fragment — Telegram style: Toolbar + Chat List with Swipe Actions + New Chat FAB -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- AppBar: flat, no elevation, surface background -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChats"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_menu"
        app:title="Chats"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIconTint="?attr/colorOnSurface"
        app:menu="@menu/menu_chats_toolbar" />

    <!-- Material 3 Divider -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="0.5dp" />

    <!-- Chat list area with FAB -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- RecyclerView for Telegram Chats -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="110dp" />

        <!-- Telegram-style Compose / New Chat Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNewChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="96dp"
            app:srcCompat="@drawable/ic_edit_2"
            app:tint="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:elevation="6dp"
            app:hoveredFocusedTranslationZ="8dp"
            app:pressedTranslationZ="12dp"
            android:contentDescription="New Message" />

    </FrameLayout>

</LinearLayout>
